<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/dp_24">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text_primary" android:textSize="@dimen/sp_20" android:textStyle="bold" />
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8" android:lineSpacingExtra="@dimen/dp_2"
        android:textColor="@color/text_secondary" android:textSize="@dimen/sp_14" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancelButton"
            style="@style/Widget.Aiyifan.ConfirmationAction" android:text="@string/confirmation_cancel" />
        <com.google.android.material.button.MaterialButton android:id="@+id/confirmButton"
            style="@style/Widget.Aiyifan.ConfirmationAction" android:layout_marginStart="@dimen/dp_12"
            android:textColor="@color/destructive_text" app:backgroundTint="@color/destructive_surface" />
    </LinearLayout>
</LinearLayout>
