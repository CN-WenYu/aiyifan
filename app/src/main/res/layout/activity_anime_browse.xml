<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/dp_16">

        <ImageButton
            android:id="@+id/animeBrowseBack"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_48"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/anime_close_page"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/animeBrowseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/sp_22"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/animeScheduleDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:visibility="gone"
        app:tabIndicatorColor="@color/accent"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/text_secondary" />

    <include
        android:id="@+id/animeBrowseStatus"
        layout="@layout/item_anime_load_state" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/animeBrowseList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_16" />
</LinearLayout>
