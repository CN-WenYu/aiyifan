<resources>
    <style name="ThemeOverlay.Aiyifan.DownloadSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Aiyifan.DownloadSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
    </style>
    <style name="Widget.Aiyifan.DownloadSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Aiyifan.DownloadSheet</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
    <style name="ShapeAppearance.Aiyifan.DownloadSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/dialog_panel_radius</item>
        <item name="cornerSizeTopRight">@dimen/dialog_panel_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Widget.Aiyifan.QueueButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/field_bg</item>
        <item name="android:textColor">@color/download_queue_action_text</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
