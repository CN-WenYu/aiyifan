<resources>
    <style name="ThemeOverlay.Aiyifan.DownloadSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Aiyifan.DownloadSheet</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="enableEdgeToEdge">true</item>
    </style>
    <style name="Widget.Aiyifan.DownloadSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Aiyifan.DownloadSheet</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
    <style name="ShapeAppearance.Aiyifan.DownloadSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
